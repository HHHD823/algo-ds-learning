{
    // 文件统一使用 UTF-8，避免中文乱码
    "files.encoding": "utf8",
    // Code Runner：在终端里运行，运行前自动保存（点右上角 ▶ 或 Ctrl+Alt+N）
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.clearPreviousOutput": true,
    // C 用 gcc、C++ 用 g++；-static 让生成的 exe 自带运行库，可直接双击运行
    "code-runner.executorMap": {
        "c": "cd \"$dir\" && gcc -g -Wall -static \"$fileName\" -o \"$fileNameWithoutExt.exe\" && .\\\"$fileNameWithoutExt.exe\"",
        "cpp": "cd \"$dir\" && g++ -g -Wall -std=c++17 -static \"$fileName\" -o \"$fileNameWithoutExt.exe\" && .\\\"$fileNameWithoutExt.exe\""
    },
    // C/C++ 智能提示：使用 gcc，C 标准 C17、C++ 标准 C++17
    "C_Cpp.default.compilerPath": "gcc.exe",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64"
}
